# Exact canonical URL, no trailing slash. Use http://127.0.0.1:3000 locally.
APP_URL=https://nandann.com
# Supabase transaction pooler connection string (port 6543), server-only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails of invited Supabase Auth users. One shared workspace.
ALLOWED_EMAILS=
# Generate with: openssl rand -base64 32. Keep stable; changing loses access to stored tokens.
TOKEN_ENCRYPTION_KEY=
# Generate a separate random secret. Vercel sends it as Authorization: Bearer ... to Cron.
CRON_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202608
X_CLIENT_ID=
X_CLIENT_SECRET=
# Server-to-server key for nandann.com. Generate another independent 32-byte random secret.
WEBSITE_API_KEY=
ARTICLE_ALLOWED_HOSTS=nandann.com,www.nandann.com
ARTICLE_TIME_ZONE=Asia/Kolkata
# Optional comma-separated account UUIDs (from /admin/api/workspace); otherwise all workspace accounts.
AUTO_PUBLISH_ACCOUNT_IDS=
# Enable after deploying the read-only article feed change to nandann.com.
# First sync records the current archive as baseline; subsequent new articles are scheduled.
ARTICLE_FEED_URL=https://nandann.com/api/social/articles
